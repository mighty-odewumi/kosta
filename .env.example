PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger
LOG_LEVEL=info

# Shared secret your payment provider uses to sign deposit webhooks
WEBHOOK_SECRET=whsec_change_me
WEBHOOK_TOLERANCE_SECONDS=300

# Withdrawal fee in basis points (50 = 0.5%)
WITHDRAWAL_FEE_BPS=50

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120

# Public URL of this API (shown in the Swagger servers list)
PUBLIC_API_URL=
# Browser origins allowed to call the API, comma-separated (e.g. the GitHub Pages docs site)
CORS_ORIGINS=https://mighty-odewumi.github.io
# Exposes /sandbox endpoints for self-serve test keys and test deposits. Never in production.
SANDBOX_MODE=false
